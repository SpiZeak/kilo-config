{
	"$schema": "https://app.kilo.ai/config.json",
	"provider": {
		"trewhitt": {
			"name": "Trewhitt",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "https://ai.trewhitt.se/v1"
			},
			"models": {
				"unsloth/Qwen3.8-27B-GGUF:UD-Q3_K_XL": {
					"name": "Qwen3.8 27B (UD-Q3_K_XL)",
					"reasoning": true,
					"attachment": true,
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					},
				"limit": {
					"context": 206000,
					"output": 32768
				},
				"options": {
					"reasoningEffort": "xhigh"
				},
				"variants": {
					"xhigh": { "reasoningEffort": "xhigh" },
					"medium": { "reasoningEffort": "medium" },
					"low": { "reasoningEffort": "low" }
				}
			},
			}
		}
	},
	"mcp": {
		"chrome-devtools": {
			"type": "local",
			"command": ["bunx", "--bun", "-y", "chrome-devtools-mcp@latest"],
			"enabled": true
		}
	},
	"permission": {
		"bash": "allow",
		"read": {
			"*": "allow"
		},
		"webfetch": "ask"
	},
	"experimental": {
		"batch_tool": true
	},
	"model": "zai-coding-plan/glm-5.3",
	"remote_control": true,
	"hide_prompt_training_models": true,
	"small_model": "fireworks-ai/accounts/fireworks/models/deepseek-v4-flash-0731",
	"subagent_model": "zai-coding-plan/glm-5.3",
	"auto_collapse_reasoning": true
}
